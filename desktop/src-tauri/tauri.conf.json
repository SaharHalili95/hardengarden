{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HardenGarden",
  "version": "0.0.1",
  "identifier": "io.github.saharhalili95.hardengarden",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "HardenGarden",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:*",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "freezePrototype": true,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Read-only Linux hardening auditor",
    "longDescription": "HardenGarden scans this Linux machine with read-only security checks, scores it, explains findings with a local AI model, and shows reviewed remediation scripts. It never changes the system.",
    "copyright": "Apache-2.0",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "resources": {
      "binaries/hardengarden-sidecar/": "sidecar/"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "section": "admin"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
