{
  "components": {
    "schemas": {
      "Category": {
        "enum": [
          "ssh",
          "firewall",
          "network",
          "filesystem",
          "accounts",
          "updates",
          "kernel",
          "logging"
        ],
        "title": "Category",
        "type": "string"
      },
      "ChatRequest": {
        "additionalProperties": false,
        "properties": {
          "question": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "CheckMeta": {
        "additionalProperties": false,
        "description": "Static description of a check. Stable forever once released.",
        "properties": {
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kb_doc": {
            "title": "Kb Doc",
            "type": "string"
          },
          "platforms": {
            "items": {
              "type": "string"
            },
            "title": "Platforms",
            "type": "array"
          },
          "rationale": {
            "title": "Rationale",
            "type": "string"
          },
          "remediation_template": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Remediation Template"
          },
          "requires_root": {
            "title": "Requires Root",
            "type": "boolean"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "category",
          "severity",
          "rationale",
          "requires_root",
          "platforms",
          "kb_doc",
          "remediation_template"
        ],
        "title": "CheckMeta",
        "type": "object"
      },
      "CheckResult": {
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "title": "Check Id",
            "type": "string"
          },
          "duration_ms": {
            "minimum": 0.0,
            "title": "Duration Ms",
            "type": "integer"
          },
          "evidence": {
            "items": {
              "maxLength": 240,
              "type": "string"
            },
            "maxItems": 10,
            "title": "Evidence",
            "type": "array"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        },
        "required": [
          "check_id",
          "status",
          "duration_ms"
        ],
        "title": "CheckResult",
        "type": "object"
      },
      "Coverage": {
        "additionalProperties": false,
        "properties": {
          "errors": {
            "title": "Errors",
            "type": "integer"
          },
          "evaluated": {
            "title": "Evaluated",
            "type": "integer"
          },
          "not_applicable": {
            "title": "Not Applicable",
            "type": "integer"
          },
          "percent": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Percent"
          },
          "skipped": {
            "title": "Skipped",
            "type": "integer"
          },
          "skipped_for_privileges": {
            "title": "Skipped For Privileges",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "total",
          "evaluated",
          "skipped",
          "errors",
          "not_applicable",
          "skipped_for_privileges",
          "percent"
        ],
        "title": "Coverage",
        "type": "object"
      },
      "ExplainRequest": {
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "pattern": "^HG-[A-Z]{2,4}-\\d{3}$",
            "title": "Check Id",
            "type": "string"
          },
          "scan_id": {
            "format": "uuid",
            "title": "Scan Id",
            "type": "string"
          },
          "use_cache": {
            "default": true,
            "title": "Use Cache",
            "type": "boolean"
          }
        },
        "required": [
          "scan_id",
          "check_id"
        ],
        "title": "ExplainRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Platform": {
        "additionalProperties": false,
        "properties": {
          "distro_id": {
            "title": "Distro Id",
            "type": "string"
          },
          "is_root": {
            "title": "Is Root",
            "type": "boolean"
          },
          "pretty_name": {
            "title": "Pretty Name",
            "type": "string"
          },
          "version_id": {
            "title": "Version Id",
            "type": "string"
          }
        },
        "required": [
          "distro_id",
          "version_id",
          "pretty_name",
          "is_root"
        ],
        "title": "Platform",
        "type": "object"
      },
      "PullRequest": {
        "additionalProperties": false,
        "properties": {
          "consent": {
            "const": true,
            "title": "Consent",
            "type": "boolean"
          },
          "model": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Model",
            "type": "string"
          }
        },
        "required": [
          "model",
          "consent"
        ],
        "title": "PullRequest",
        "type": "object"
      },
      "ScanReport": {
        "additionalProperties": false,
        "properties": {
          "platform": {
            "$ref": "#/components/schemas/Platform"
          },
          "platform_supported": {
            "title": "Platform Supported",
            "type": "boolean"
          },
          "privilege_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Privilege Hint"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/CheckResult"
            },
            "title": "Results",
            "type": "array"
          },
          "scanned_root": {
            "title": "Scanned Root",
            "type": "string"
          },
          "summary": {
            "$ref": "#/components/schemas/ScoreSummary"
          },
          "tool_version": {
            "title": "Tool Version",
            "type": "string"
          }
        },
        "required": [
          "tool_version",
          "scanned_root",
          "platform",
          "platform_supported",
          "results",
          "summary",
          "privilege_hint"
        ],
        "title": "ScanReport",
        "type": "object"
      },
      "ScanResponse": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "report": {
            "$ref": "#/components/schemas/ScanReport"
          }
        },
        "required": [
          "id",
          "report"
        ],
        "title": "ScanResponse",
        "type": "object"
      },
      "ScoreSummary": {
        "additionalProperties": false,
        "properties": {
          "coverage": {
            "$ref": "#/components/schemas/Coverage"
          },
          "score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          }
        },
        "required": [
          "score",
          "coverage"
        ],
        "title": "ScoreSummary",
        "type": "object"
      },
      "Settings": {
        "additionalProperties": false,
        "properties": {
          "chat_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chat Model"
          },
          "embed_model": {
            "default": "nomic-embed-text",
            "maxLength": 100,
            "minLength": 1,
            "title": "Embed Model",
            "type": "string"
          },
          "generation_timeout_s": {
            "default": 120,
            "maximum": 600.0,
            "minimum": 10.0,
            "title": "Generation Timeout S",
            "type": "integer"
          },
          "max_tokens": {
            "default": 400,
            "maximum": 1024.0,
            "minimum": 64.0,
            "title": "Max Tokens",
            "type": "integer"
          },
          "ollama_url": {
            "default": "http://127.0.0.1:11434",
            "title": "Ollama Url",
            "type": "string"
          },
          "retrieval_threshold": {
            "default": 0.3,
            "exclusiveMinimum": 0.0,
            "maximum": 1.0,
            "title": "Retrieval Threshold",
            "type": "number"
          }
        },
        "title": "Settings",
        "type": "object"
      },
      "SettingsUpdate": {
        "additionalProperties": false,
        "properties": {
          "chat_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chat Model"
          },
          "clear_chat_model": {
            "default": false,
            "title": "Clear Chat Model",
            "type": "boolean"
          },
          "generation_timeout_s": {
            "anyOf": [
              {
                "maximum": 600.0,
                "minimum": 10.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Generation Timeout S"
          },
          "max_tokens": {
            "anyOf": [
              {
                "maximum": 1024.0,
                "minimum": 64.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Tokens"
          },
          "ollama_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ollama Url"
          }
        },
        "title": "SettingsUpdate",
        "type": "object"
      },
      "Severity": {
        "enum": [
          "CRITICAL",
          "HIGH",
          "MEDIUM",
          "LOW",
          "INFO"
        ],
        "title": "Severity",
        "type": "string"
      },
      "Status": {
        "enum": [
          "PASS",
          "FAIL",
          "WARN",
          "ERROR",
          "SKIPPED",
          "NOT_APPLICABLE"
        ],
        "title": "Status",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "HardenGarden local API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
