#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# HardenGarden remediation for HG-KRN-001: ASLR enabled
# Generated by HardenGarden <version>. REVIEW BEFORE RUNNING.
#
# Dry run by default: this prints what it would change and changes nothing.
# To apply:  sudo HG_APPLY=1 bash hg-krn-001.sh
# Files are backed up as <file>.hardengarden-bak.<timestamp> before editing.
# ---------------------------------------------------------------------------
set -euo pipefail

APPLY="${HG_APPLY:-0}"
CONF=/etc/sysctl.d/99-hardengarden-aslr.conf
say() { printf '[hardengarden] %s\n' "$*"; }
die() { printf '[hardengarden] ERROR: %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "run as root (for example: sudo HG_APPLY=1 bash $0)"

current="$(cat /proc/sys/kernel/randomize_va_space 2>/dev/null || echo unknown)"
persisted=0
[ -f "$CONF" ] && grep -Eq '^[[:space:]]*kernel\.randomize_va_space[[:space:]]*=[[:space:]]*2[[:space:]]*$' "$CONF" && persisted=1

if [ "$current" = "2" ] && [ "$persisted" -eq 1 ]; then
    say "ASLR is fully enabled and persisted. Nothing to do."
    exit 0
fi
say "kernel.randomize_va_space is currently $current"

if [ "$APPLY" != "1" ]; then
    say "DRY RUN: would set kernel.randomize_va_space=2 now and persist it in $CONF"
    say "Nothing was changed. Re-run with HG_APPLY=1 to apply."
    exit 0
fi

printf '# Managed by HardenGarden: full address space layout randomization.\nkernel.randomize_va_space = 2\n' > "$CONF"
chmod 0644 "$CONF"
say "Wrote $CONF (named to be applied last, so it wins over earlier files)"
if sysctl -w kernel.randomize_va_space=2 >/dev/null 2>&1; then
    say "Running value set to $(cat /proc/sys/kernel/randomize_va_space)"
else
    say "WARNING: could not change the running value (for example inside a container); it applies at next boot."
fi
for f in /etc/sysctl.d/*.conf /run/sysctl.d/*.conf /usr/local/lib/sysctl.d/*.conf /usr/lib/sysctl.d/*.conf; do
    [ -f "$f" ] || continue
    if grep -Eq '^[[:space:]]*kernel\.randomize_va_space[[:space:]]*=[[:space:]]*[01][[:space:]]*$' "$f"; then
        say "Note: $f lowers this setting; $CONF overrides it, but consider removing that line."
    fi
done
say "Done."
