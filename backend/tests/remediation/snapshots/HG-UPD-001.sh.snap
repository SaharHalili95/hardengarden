#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# HardenGarden remediation for HG-UPD-001: Automatic security updates enabled
# Generated by HardenGarden <version>. REVIEW BEFORE RUNNING.
#
# Dry run by default: this prints what it would change and changes nothing.
# To apply:  sudo HG_APPLY=1 bash hg-upd-001.sh
# Files are backed up as <file>.hardengarden-bak.<timestamp> before editing.
# ---------------------------------------------------------------------------
set -euo pipefail

APPLY="${HG_APPLY:-0}"
STAMP="$(date +%Y%m%d%H%M%S)"
CONF=/etc/apt/apt.conf.d/20auto-upgrades
say() { printf '[hardengarden] %s\n' "$*"; }
die() { printf '[hardengarden] ERROR: %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "run as root (for example: sudo HG_APPLY=1 bash $0)"
command -v apt-get >/dev/null 2>&1 || die "apt-get not found; this script is for Debian and Ubuntu"

installed=0
dpkg-query -W -f='${Status}' unattended-upgrades 2>/dev/null | grep -q 'install ok installed' && installed=1
setting() { apt-config dump 2>/dev/null | awk -v k="$1" '$1 == k { gsub(/[";]/, "", $2); print $2 }' | tail -n 1; }
lists="$(setting APT::Periodic::Update-Package-Lists)"
upgrades="$(setting APT::Periodic::Unattended-Upgrade)"

if [ "$installed" -eq 1 ] && [ "${lists:-0}" != "0" ] && [ "${upgrades:-0}" != "0" ]; then
    say "unattended-upgrades is installed and enabled. Nothing to do."
    exit 0
fi

if [ "$APPLY" != "1" ]; then
    [ "$installed" -eq 1 ] || say "DRY RUN: would install the unattended-upgrades package."
    say "DRY RUN: would write $CONF with Update-Package-Lists \"1\" and Unattended-Upgrade \"1\"."
    say "Nothing was changed. Re-run with HG_APPLY=1 to apply."
    exit 0
fi

if [ "$installed" -eq 0 ]; then
    say "Installing unattended-upgrades"
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y unattended-upgrades
fi
if [ -e "$CONF" ]; then cp -a "$CONF" "$CONF.hardengarden-bak.$STAMP"; say "Backed up $CONF"; fi
printf 'APT::Periodic::Update-Package-Lists "1";\nAPT::Periodic::Unattended-Upgrade "1";\n' > "$CONF"
chmod 0644 "$CONF"
say "Wrote $CONF"

lists="$(setting APT::Periodic::Update-Package-Lists)"
upgrades="$(setting APT::Periodic::Unattended-Upgrade)"
if [ "${lists:-0}" = "0" ] || [ "${upgrades:-0}" = "0" ]; then
    say "WARNING: a file later in /etc/apt/apt.conf.d still disables automatic updates:"
    grep -lE 'APT::Periodic::(Update-Package-Lists|Unattended-Upgrade)[[:space:]]+"0"' /etc/apt/apt.conf.d/* || true
    exit 1
fi
say "Done. Effective values: Update-Package-Lists=$lists, Unattended-Upgrade=$upgrades"
say "Logs will appear in /var/log/unattended-upgrades/."
